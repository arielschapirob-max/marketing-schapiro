# Configuración de base de datos (SQLite local por defecto)
DATABASE_URL=sqlite:///data/app.db

# Carpeta de almacenamiento de archivos cargados por caso
STORAGE_DIR=data/casos

# Rutas opcionales para OCR (ajustar según instalación local).
# Déjelas vacías si Tesseract/Poppler ya están en el PATH del sistema (típico en macOS/Linux).
# Windows - ruta al ejecutable de Tesseract, ej: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Windows - ruta a la carpeta bin de Poppler, ej: C:\poppler-24.02.0\Library\bin
POPPLER_PATH=

# Nunca activar sin autorización expresa del cliente y del abogado responsable.
# La aplicación NO envía documentos a servicios externos aunque esta variable esté en true;
# solo habilita módulos opcionales que el propio abogado debe activar caso a caso.
PERMITIR_IA_EXTERNA=false

# Usuario que queda registrado en el historial de accesos y cambios
USUARIO_ACTUAL=abogado

IDIOMA=es
