APP_NAME=Análisis de Cuentas Clínicas
APP_ENV=development

# Base de datos SQLite local
DATABASE_URL=sqlite:///storage/casos.db

# Carpeta donde se guardan los documentos cargados y los informes generados por caso
OUTPUT_DIRECTORY=output

# Idioma para el OCR de Tesseract
TESSERACT_LANG=spa

# Tamaño máximo (en MB) por archivo cargado
MAX_FILE_SIZE_MB=25

# Nunca activar sin autorización expresa del cliente y del abogado responsable.
# Habilita la verificación del deducible CAEC con IA (pantalla de Hallazgos): al usarla,
# se envían a la API de Anthropic los datos que el abogado ingrese ahí (cotización pactada,
# y código/descripción/montos de los ítems de ese cálculo — nunca el resto de la cuenta
# ni documentos completos). Requiere además ANTHROPIC_API_KEY configurada más abajo.
ENABLE_EXTERNAL_AI=false

# API key de Anthropic (console.anthropic.com), solo necesaria si ENABLE_EXTERNAL_AI=true.
ANTHROPIC_API_KEY=

# Usuario que queda registrado en el historial de accesos y cambios
CURRENT_USER=abogado

# Rutas opcionales para OCR, solo si Tesseract/Poppler NO están en el PATH del sistema
# (por ejemplo, en Windows sin agregarlos al PATH durante la instalación).
# Windows - ruta al ejecutable de Tesseract, ej: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Windows - ruta a la carpeta bin de Poppler, ej: C:\poppler-24.02.0\Library\bin
POPPLER_PATH=
