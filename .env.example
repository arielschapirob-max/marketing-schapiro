# =========================================================
# PYMELEGAL — Variables de entorno
# Copia este archivo a .env y completa los valores reales.
# En desarrollo, si faltan credenciales de servicios externos,
# la aplicación arranca igualmente usando adaptadores MOCK.
# =========================================================

# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://pymelegal:pymelegal_dev_pw@localhost:5432/pymelegal"
SHADOW_DATABASE_URL="postgresql://pymelegal:pymelegal_dev_pw@localhost:5432/pymelegal_shadow"

# --- Autenticación ---
# Genera uno con: openssl rand -base64 32
AUTH_SECRET="dev-only-change-me-please-32-bytes-min"
APP_URL="http://localhost:3000"

# --- Almacenamiento de documentos (S3-compatible) ---
# Si STORAGE_ENDPOINT queda vacío, se usa el adaptador local (storage/uploads).
STORAGE_DRIVER="local"
STORAGE_ENDPOINT=""
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="pymelegal-documents"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# --- Proveedor de Inteligencia Artificial ---
# AI_PROVIDER: "mock" | "anthropic" | "openai"
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL="claude-sonnet-5"
AI_TIMEOUT_MS="30000"
AI_MAX_RETRIES="2"

# --- OCR ---
# OCR_PROVIDER: "mock" | "tesseract" | "external"
OCR_PROVIDER="mock"
OCR_API_KEY=""

# --- Colas / cache ---
# Si REDIS_URL queda vacío, los trabajos "largos" se ejecutan en modo síncrono.
REDIS_URL=""

# --- Antivirus para documentos subidos ---
# ANTIVIRUS_ENDPOINT vacío => adaptador mock (solo verifica extensión/tamaño/firma de tipo).
ANTIVIRUS_ENDPOINT=""

# --- Correo saliente ---
EMAIL_PROVIDER="mock"
EMAIL_API_KEY=""

# --- Observabilidad ---
SENTRY_DSN=""

# --- Análisis web ---
WEB_ANALYSIS_MAX_PAGES="5"
WEB_ANALYSIS_TIMEOUT_MS="8000"
WEB_ANALYSIS_MAX_BYTES="2000000"

# --- Vigencia normativa (para pruebas y demos; NO usar para alterar la ley real) ---
LEY_21719_FECHA_PUBLICACION="2024-12-13"
LEY_21719_VIGENCIA_GENERAL="2026-12-01"
